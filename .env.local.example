# Copy this file to `.env.local` and fill in the values from
# https://www.sanity.io/manage (or the output of `npx sanity init`).
#
# Until NEXT_PUBLIC_SANITY_PROJECT_ID is set, the site serves the static
# fallback content in lib/*.ts and everything keeps working.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional. Only needed for a private dataset or to preview drafts.
# Create one at https://www.sanity.io/manage -> API -> Tokens (Viewer role).
SANITY_API_READ_TOKEN=
